# SellSnap Environment Variables
# Copy to .env.local for local development.
# For Vercel: set these in the Vercel dashboard (Settings → Environment Variables).

# ── Database ────────────────────────────────────────────────────────────────
# Local dev:  file:./dev.db          (SQLite, default)
# Production: postgresql://...        (PostgreSQL — required for Vercel)
DATABASE_URL="file:./dev.db"

# ── App ─────────────────────────────────────────────────────────────────────
# Local dev:  http://localhost:3000
# Production: https://your-app.vercel.app
APP_URL=http://localhost:3000

# ── Flutterwave ─────────────────────────────────────────────────────────────
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
FLW_SECRET_HASH=

# ── SMTP / Email (SendGrid, Mailgun, Brevo, etc.) ──────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SELL SNAP <noreply@sellsnap.com>"
